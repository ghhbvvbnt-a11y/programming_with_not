rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Student profile photos: students/{uid}.jpg — only the owner can upload
    match /students/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && file == (request.auth.uid + '.jpg');
    }

    // Teacher profile photo — only the teacher account can upload
    match /teacher/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == 'ghhbvvbnt@gmail.com';
    }

    // Course cover images — only the teacher account can upload
    match /courses/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == 'ghhbvvbnt@gmail.com';
    }

    // Payment receipt photos: payments/{uid}_{timestamp}.jpg — only the owner can upload
    match /payments/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && file.matches(request.auth.uid + '_.*');
    }
  }
}
